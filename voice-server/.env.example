OPENAI_API_KEY=your-openai-api-key-here
COMPANY_NAME=Bharat Saathi
SALES_BOT_NAME=Bharat Saathi Assistant

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SAMPLE_RATE=8000
DEFAULT_SAMPLE_RATE=8000
OPENAI_MODEL=gpt-realtime
OPENAI_VOICE=coral
LOG_LEVEL=INFO

# Debug only — causes a beep before the greeting when true
SEND_TEST_TONE=false

# AgentStream outbound: 200ms = 3200 bytes @ 8 kHz (Exotel min chunk)
EXOTEL_OUTBOUND_FRAME_MS=200
OPENAI_RESAMPLE_BLOCK_MS=200
# 0 = send frames ASAP (low latency); 0.9 ≈ realtime pacing
OUTBOUND_PACE_FACTOR=0
# Skip mic→OpenAI while bot audio plays
HALF_DUPLEX=true
# Pre-cache TTS greeting and play on start before Realtime connects
INSTANT_GREETING=true

# Required: private path token for Exotel's WebSocket endpoint. Generate a long random value.
EXOTEL_STREAM_TOKEN=replace-with-a-long-random-secret

# Privacy-first defaults
CONVERSATION_RECORDING=false
DETAILED_ANALYTICS=false
METRICS_ENABLED=false
BOT_INSTRUCTIONS=You are Bharat Saathi's AI voice assistant. Speak naturally in Hindi or English according to the caller. Keep replies concise and clear. Never ask for passwords, OTPs, API keys, or banking credentials. Do not claim to perform actions you cannot perform. If you cannot help, say so clearly.
GREETING_TEXT=Namaste, Bharat Saathi se aapka swagat hai. Main aapki kis tarah madad kar sakta hoon?
